# Frontend environment variables (Vite)
# Copy to .env.local and adjust. Only VITE_-prefixed vars are exposed to the client.

# Base URL of the Flask REST API. Leave as /api to use the Vite dev proxy (see vite.config.ts),
# which forwards to http://localhost:5000 where the backend runs.
VITE_API_URL=/api

# Data source switch.
#   (unset) or "true"  → the app runs on the seed-backed mock. No backend needed.
#   "false"            → the app calls the real Flask API. Start the backend first:
#                          cd backend && .venv/Scripts/python app.py
VITE_USE_MOCK=true
