# Frontend environment variables (Vite)
# Copy to .env.local for local development.
#
# Only VITE_-prefixed variables are exposed to the client. They are inlined at BUILD time,
# so changing one requires a rebuild (and on Render it must be set as a build-time
# environment variable on the static site). See DEPLOY.md.

# ── Data source ──────────────────────────────────────────────────────────────
#   (unset) or "true"  → seed-backed mock. No backend needed; works offline.
#   "false"            → the real Flask API.
VITE_USE_MOCK=false

# ── API base URL ─────────────────────────────────────────────────────────────
# Local development: leave as /api and the Vite dev proxy forwards to port 5000
# (see vite.config.ts). That proxy only exists during development.
VITE_API_URL=/api

# Production: an ABSOLUTE url is required, because there is no dev proxy.
# VITE_API_URL=https://fleet-sme-api.onrender.com/api
