# Backend environment — copy to .env and adjust.
# The app runs with zero configuration (SQLite + a dev secret); these are the overrides.

# Persistence. Default is SQLite at backend/fms.db.
# PostgreSQL (PRD Table 4.1) example:
#   DATABASE_URL=postgresql+psycopg2://fms:secret@localhost:5432/fms
# DATABASE_URL=sqlite:///fms.db

# Auth (NFR2) — ALWAYS override in production.
# JWT_SECRET_KEY=change-me-to-a-long-random-string
# JWT_HOURS=12

# CORS — comma-separated origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173
