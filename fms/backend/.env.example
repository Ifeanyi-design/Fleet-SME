# Backend environment — copy to .env and adjust.
# The app runs with zero configuration (SQLite + a dev secret); these are the overrides.
# For deployment, see DEPLOY.md at the project root.

# ── Persistence ──────────────────────────────────────────────────────────────
# Default is SQLite at backend/fms.db — fine for local development.
#
# IMPORTANT: SQLite must NOT be used on a host with an ephemeral filesystem (Render,
# Heroku). The file is wiped on every deploy and all data is lost. Set DATABASE_URL to
# PostgreSQL there. The URL scheme is normalised automatically, so Render's
# `postgres://…` form works as-is.
# DATABASE_URL=postgresql://fms:secret@localhost:5432/fms

# ── Auth (NFR2) ──────────────────────────────────────────────────────────────
# ALWAYS override in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=change-me-to-a-long-random-string
# JWT_HOURS=12

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. In production this must include the
# deployed frontend origin, or the browser will block every request.
# CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=https://fleet-sme-web.onrender.com

# ── Seeding ──────────────────────────────────────────────────────────────────
# Seed the Case Organisation A baseline when the database is empty. Set to "false" to
# start with a completely empty system.
# AUTO_SEED=true
